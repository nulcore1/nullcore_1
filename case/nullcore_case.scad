// ============================================================
//  nullcore — корпус (tray), открытый сзади.
//  Экран ST7789 2.0" (PCB 37.5 x 56.3 мм) спереди, 3 кнопки под ним,
//  вырез под USB-C сбоку. Размеры параметрические — подгони штангелем.
// ============================================================
$fn = 72;

// ===== РАЗМЕРЫ ЭКРАНА (мм) — стандартный 2.0" ST7789 =====
disp_pcb_w  = 37.5;  // ширина ПЛАТЫ экрана
disp_pcb_h  = 56.3;  // высота ПЛАТЫ экрана
win_w       = 31;    // ширина видимого окна (видимая область ~30.6)
win_h       = 41;    // высота видимого окна (видимая область ~40.9)

// ===== КНОПКИ (квадратные) =====
btn_size    = 6;     // сторона квадратного отверстия (кнопка 5 мм + зазор)
btn_n       = 3;     // число кнопок
btn_pitch   = 14;    // расстояние между центрами кнопок
btn_zone    = 22;    // высота зоны под кнопками (ниже экрана)

// ===== КОРПУС =====
wall        = 2.4;   // толщина стенок
depth       = 17;    // внутренняя глубина (стопка электроники)
clr         = 1.5;   // зазор вокруг платы экрана по бокам
corner_r    = 4;     // радиус внешних углов

// ===== USB-C =====
usb_w       = 11;    // ширина выреза USB-C
usb_h       = 5.5;   // высота выреза USB-C
usb_z       = 8;     // центр выреза по глубине (от передней стенки)
// =========================================================

inner_w = disp_pcb_w + 2*clr;
inner_h = disp_pcb_h + btn_zone;
outer_w = inner_w + 2*wall;
outer_h = inner_h + 2*wall;
outer_d = depth + wall;

// позиции по Y (от низа outer): экран занимает верхнюю часть
win_y    = wall + btn_zone + (disp_pcb_h - win_h)/2;   // низ окна
btn_y    = wall + btn_zone/2;                          // центр ряда кнопок

module rbox(w,h,d,r){
    hull() for(x=[r, w-r]) for(y=[r, h-r])
        translate([x,y,0]) cylinder(r=r, h=d);
}

difference(){
    rbox(outer_w, outer_h, outer_d, corner_r);               // корпус

    translate([wall, wall, wall])                            // полость, открыта сзади
        cube([inner_w, inner_h, outer_d]);

    translate([(outer_w-win_w)/2, win_y, -1])                // окно экрана
        cube([win_w, win_h, wall+2]);

    for(i=[0:btn_n-1])                                       // кнопки (квадратные)
        translate([outer_w/2 + (i-(btn_n-1)/2)*btn_pitch - btn_size/2, btn_y - btn_size/2, -1])
            cube([btn_size, btn_size, wall+2]);

    translate([(outer_w-usb_w)/2, -1, usb_z - usb_h/2])      // USB-C вырез (низ)
        cube([usb_w, wall+2, usb_h]);
}
